CONTENT_FLOW_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
META_APP_ID=
META_APP_SECRET=
# Graph API version used for all Meta calls (default v26.0)
META_GRAPH_VERSION=v26.0
# Random string you also enter in the Meta app's Webhooks settings. Leave empty to keep webhooks disabled.
META_WEBHOOK_VERIFY_TOKEN=
CONTENT_FLOW_TOKEN_ENCRYPTION_KEY=
# The API's public HTTPS URL (OAuth callback; Meta downloads Instagram media from it)
CONTENT_FLOW_API_PUBLIC_URL=http://127.0.0.1:8000
CONTENT_FLOW_FRONTEND_URL=http://localhost:3000
CONTENT_FLOW_PUBLISHER_ENABLED=false
CONTENT_FLOW_PUBLISHER_INTERVAL_SECONDS=60
# Attempts per account for errors Meta reports as temporary (backoff 2, 10, 30 min)
CONTENT_FLOW_PUBLISH_MAX_ATTEMPTS=3
# Abuse and cost limits (defaults shown)
CONTENT_FLOW_AI_PER_MINUTE_LIMIT=10
CONTENT_FLOW_AI_DAILY_LIMIT=50
CONTENT_FLOW_LOGIN_PER_IP_LIMIT=20
CONTENT_FLOW_LOGIN_FAILURES_PER_EMAIL_LIMIT=5
CONTENT_FLOW_REGISTER_PER_HOUR_LIMIT=5
