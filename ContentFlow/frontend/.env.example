# Local development: the browser calls the API directly.
NEXT_PUBLIC_CONTENT_FLOW_API_URL=http://localhost:8000

# Production (Vercel): leave NEXT_PUBLIC_CONTENT_FLOW_API_URL unset (or set it to "/").
# /api/* is then proxied to CONTENT_FLOW_API_INTERNAL_URL, which defaults to the live
# Render backend (https://content-flow-wqzd.onrender.com) on Vercel builds.
# Do not point NEXT_PUBLIC_CONTENT_FLOW_API_URL at the Render URL: the session cookie
# would become cross-site and the browser would not send it.
# CONTENT_FLOW_API_INTERNAL_URL=https://content-flow-wqzd.onrender.com
